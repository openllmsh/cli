{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$OPENLLM_BIN\" exec ctx session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Bash|grep|list_dir|run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "command": "\"$OPENLLM_BIN\" exec ctx grep-nudge",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|edit_file|create_file",
        "hooks": [
          {
            "type": "command",
            "command": "\"$OPENLLM_BIN\" exec ctx reindex-on-edit",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$OPENLLM_BIN\" exec memory recall",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$OPENLLM_BIN\" exec memory extract",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
