{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$OPENLLM_BIN\" exec memory recall",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$OPENLLM_BIN\" exec memory extract",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
