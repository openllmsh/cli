{
  "model": "ultra[1m]",
  "statusLine": {
    "type": "command",
    "command": "{{HOOKS_DIR}}/statusline.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/ctx-session-start.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/ctx-grep-nudge.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/ctx-reindex-on-edit.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/mem-recall-on-prompt.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/mem-extract-on-stop.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
