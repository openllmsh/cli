{
  "model": "ultra",
  "env": {
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "1000000"
  },
  "statusLine": {
    "type": "command",
    "command": "{{HOOKS_DIR}}/statusline.sh"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$OPENLLM_BIN\" exec memory recall",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$OPENLLM_BIN\" exec memory extract",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
