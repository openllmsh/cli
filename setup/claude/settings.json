{
  "model": "ultra",
  "env": {
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "1000000",
    "CLAUDE_CODE_AUTO_MODE_SERVER": "0"
  },
  "statusLine": {
    "type": "command",
    "command": "{{HOOKS_DIR}}/statusline.sh"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$OPENLLM_BIN\" exec memory recall",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$OPENLLM_BIN\" exec memory extract",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$OPENLLM_BIN\" exec agent hook Stop",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$OPENLLM_BIN\" exec ad --client claude",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$OPENLLM_BIN\" exec agent hook SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$OPENLLM_BIN\" exec agent hook PermissionRequest",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$OPENLLM_BIN\" exec agent hook PreToolUse",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
